{
  "name": "northstar-telemetry-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "frontend/electron/main.cjs",
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "concurrently -k -n API,DESKTOP \"npm:dev:api\" \"npm:dev:desktop\"",
    "dev:api": "tsx watch backend/server.ts",
    "dev:desktop": "concurrently -k \"cd frontend && ng serve --host 127.0.0.1\" \"wait-on http://127.0.0.1:4200 && electron . --dev\"",
    "dev:web": "cd frontend && ng serve --host 127.0.0.1",
    "start:api": "node backend/dist/server.js",
    "build": "npm run build:frontend && npm run build:api",
    "build:frontend": "cd frontend && ng build",
    "build:api": "tsc -p backend/tsconfig.json",
    "test": "cd frontend && ng test",
    "electron": "electron ."
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "cors": "^2.8.6",
    "electron": "^44.9.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  }
}
